# Copy values into your shell or deployment-secret manager. Never commit a real key.
OPENROUTER_API_KEY=sk-or-your-openrouter-key
PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
OPENROUTER_APP_TITLE=malem
# Optional local account store path. Defaults to .malem-data/accounts.json.
# MALEM_DATA_FILE=/absolute/path/to/accounts.json
# Test-only override; leave unset for real OpenRouter:
# OPENROUTER_API_BASE=http://127.0.0.1:9100
